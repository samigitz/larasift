{
    "name": "samigitz/larasift",
    "description": "A fast, configurable security scanner for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "security",
        "security scanner",
        "static analysis",
        "sast",
        "xss"
    ],
    "homepage": "https://github.com/samigitz/larasift",
    "authors": [
        {
            "name": "Sampath Arachchige",
            "homepage": "https://github.com/samigitz",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/samigitz/larasift/issues",
        "security": "https://github.com/samigitz/larasift/security/policy",
        "source": "https://github.com/samigitz/larasift"
    },
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.2",
        "ext-json": "*",
        "nikic/php-parser": "^5.4",
        "symfony/console": "^7.2|^8.0",
        "symfony/finder": "^7.2|^8.0",
        "symfony/string": "^7.2|^8.0",
        "symfony/yaml": "^7.2|^8.0"
    },
    "require-dev": {
        "laravel/pint": "~1.30.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "LaraSift\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraSift\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/larasift"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:test": "pint --test",
        "check": [
            "@test",
            "phpstan analyse --no-progress --debug",
            "@format:test"
        ]
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.phpunit.cache",
            "/.zsh_history",
            "/SECURITY_SCANNER_PLAN.md",
            "/tests",
            "/vendor",
            "/.gitattributes",
            "/.gitignore",
            "/composer.lock",
            "/phpstan.neon",
            "/phpunit.xml"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {}
    }
}
