{
    "name": "larasift/larasift",
    "description": "A configurable Laravel security scanner for common application vulnerabilities.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nikic/php-parser": "^5.4",
        "symfony/console": "^7.2",
        "symfony/finder": "^7.2",
        "symfony/string": "^7.2",
        "symfony/yaml": "^7.2"
    },
    "require-dev": {
        "laravel/pint": "~1.22.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "LaraSift\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraSift\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/larasift"
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {}
    }
}
