#!/usr/bin/env php
<?php

declare(strict_types=1);

use LaraSift\Application;

$autoload = $_composer_autoload_path ?? dirname(__DIR__).'/vendor/autoload.php';

if (! is_file($autoload)) {
    fwrite(STDERR, "LaraSift dependencies are missing. Run composer install.\n");
    exit(3);
}

require $autoload;

exit((new Application)->run());
